HOST="localhost"
BASE_URL="http://localhost:3000"

OAUTH_HEALTH_CHECK_URL="http://localhost:4445/health/ready"
OAUTH_FRONTEND_LOGIN_URL="http://localhost:3000/auth/login"
OAUTH_FRONTEND_LOGIN_ERROR_URL="http://localhost:3000/auth/login/error"

OAUTH_ADMIN_URL="http://localhost:4445"
OAUTH_PROVIDER_URL="http://localhost:4444"
OAUTH_REDIRECT_URL="http://localhost:3000/api/auth/callback"
OAUTH_ACCESS_TOKEN_EXPIRY_WEB_HOURS=240
OAUTH_REFRESH_TOKEN_EXPIRY_WEB_HOURS=720
OAUTH_GRANT_ACCESS_TOKEN_AUDIENCE="chaty"
OAUTH_CLIENT_ID=08f5f501-be59-4eaf-8077-5e34bdc37788
OAUTH_CLIENT_SECRET=super-secret

NEXT_PUBLIC_OAUTH_CLIENT_ID=08f5f501-be59-4eaf-8077-5e34bdc37788
NEXT_PUBLIC_OAUTH_AUTH_URL="http://localhost:4444/oauth2/auth"
NEXT_PUBLIC_OAUTH_REDIRECT_URL="http://localhost:3000/api/auth/callback"

NEXT_PUBLIC_GRPC_ENDPOINT="http://localhost:8092"

NEXT_PUBLIC_CHATY_VERSION=0.1.3

# Whether to emit additional debug information
NEXT_PUBLIC_DEBUG=true

# What WS server to connect to by default.
NEXT_PUBLIC_WS_URL=wss://localhost/events

# What media server to connect to by default.
NEXT_PUBLIC_MEDIA_URL=http://localhost

# What proxy server to connect to by default.
NEXT_PUBLIC_PROXY_URL=http://localhost

# hCaptcha site key to use if enabled
NEXT_PUBLIC_HCAPTCHA_SITEKEY=

# Maximum number of replies a message can have
NEXT_PUBLIC_MAX_REPLIES=5

# Maximum number of attachments a message can have
NEXT_PUBLIC_MAX_ATTACHMENTS=5

# Maximum number of emoji a server can have
NEXT_PUBLIC_MAX_EMOJI=100

# Max file size allowed for uploads (in bytes) - 20 MB = 20 * 1024 * 1024 = 20,971,520 bytes
NEXT_PUBLIC_MAX_FILE_SIZE=20000000

# Session ID to set during development.
NEXT_PUBLIC_DEV_SESSION_ID=
# Token to set during development.
NEXT_PUBLIC_DEV_TOKEN=
# User ID to set during development.
NEXT_PUBLIC_DEV_USER_ID=
